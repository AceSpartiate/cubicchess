{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        ".read": "auth != null && $code.length === 4",
        ".write": "auth != null && (!data.exists() || data.child('createdAt').val() < now - 86400000)",
        ".validate": "newData.hasChildren(['createdAt','seats']) && (newData.child('seats/w/uid').val() === auth.uid || newData.child('seats/b/uid').val() === auth.uid) && (data.exists() || !newData.hasChild('moves'))",

        "createdAt": { ".validate": "newData.val() === now" },
        "status":    { ".validate": "newData.isString() && newData.val().length <= 8" },
        "result":    { ".validate": "newData.isString() && newData.val().length <= 16" },
        "lastUid":   { ".validate": "newData.val() === auth.uid" },

        "seats": {
          "$c": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || data.child('lastSeen').val() < now - 90000) && (($c === 'w' && root.child('rooms/' + $code + '/seats/b/uid').val() !== auth.uid) || ($c === 'b' && root.child('rooms/' + $code + '/seats/w/uid').val() !== auth.uid))",
            ".validate": "($c === 'w' || $c === 'b') && newData.hasChildren(['uid','name','lastSeen'])",

            "uid":      { ".validate": "newData.val() === auth.uid" },
            "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12" },
            "lastSeen": { ".validate": "newData.val() === now" },
            "$other":   { ".validate": false }
          }
        },

        "moves": {
          "$ply": {
            ".write": "auth != null && !data.exists() && (root.child('rooms/' + $code + '/seats/w/uid').val() === auth.uid || root.child('rooms/' + $code + '/seats/b/uid').val() === auth.uid) && root.child('rooms/' + $code + '/lastUid').val() !== auth.uid && ($ply !== '0' || root.child('rooms/' + $code + '/seats/w/uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['v','uid']) && $ply.matches(/^[0-9]{1,3}$/) && newData.root().child('rooms/' + $code + '/lastUid').val() === auth.uid",

            "v":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2097151" },
            "uid":    { ".validate": "newData.val() === auth.uid" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "users": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "stats": {
          "w": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "l": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "d": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
